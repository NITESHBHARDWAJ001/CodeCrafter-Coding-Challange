# ── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in certificate QR codes / verification links / email redirects)
PUBLIC_APP_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the API (1 on Render/Fly/Heroku-style platforms) so rate limits see real client IPs
TRUST_PROXY=0

# ── Supabase (Project Settings -> API) ──────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# SECRET. Bypasses RLS. Server-side only; never ship to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# ── Registration policy ─────────────────────────────────────────────
# Optional comma-separated allow-list of student email domains, e.g. ds.study.iitm.ac.in,es.study.iitm.ac.in. Empty = any.
ALLOWED_EMAIL_DOMAINS=
# Accounts registering with these emails are promoted to ADMIN (bootstrap the first admin, then clear it)
BOOTSTRAP_ADMIN_EMAILS=
# Verify that the LeetCode username exists at sign-up (recommended)
REQUIRE_LEETCODE_VALIDATION=true

# ── Scheduler ───────────────────────────────────────────────────────
# Run cron jobs (scheduled sync, program status advance) in THIS process.
# Enable on exactly ONE instance if you scale horizontally.
ENABLE_SCHEDULER=true

# ── LeetCode integration (unofficial GraphQL endpoint) ──────────────
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
LEETCODE_TIMEOUT_MS=10000
LEETCODE_MAX_RETRIES=3
# Global outgoing request rate. Be polite: ~4/s means ~500 users take about 2 minutes.
LEETCODE_REQUESTS_PER_SECOND=4
# Per-user submission list cache (also de-duplicates concurrent lookups)
LEETCODE_CACHE_TTL_SECONDS=120
# How many participants are verified in parallel during a sync
SYNC_CONCURRENCY=4
# Keep syncing a COMPLETED program for this long after it ends so final-day solves are captured
COMPLETED_PROGRAM_SYNC_GRACE_HOURS=48

# ── Seed script only ────────────────────────────────────────────────
# SEED_PASSWORD=CodeCrafter#2026
